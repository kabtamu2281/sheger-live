# Copy to .env (never commit it) or set these in your hosting provider's secret manager.
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL=claude-opus-5-5
PORT=8080
DATA_FILE=./data/store.json
# Comma-separated origins are not needed: the Android app is the only client.
# Payment provider is not configured by default; checkout returns 501 until it is.
PAYMENT_PROVIDER=
