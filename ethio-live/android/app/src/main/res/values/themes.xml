<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EthioLive" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/brand_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.EthioLive.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EthioLive</item>
    </style>
</resources>
