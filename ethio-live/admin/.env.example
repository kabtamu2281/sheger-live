# Copy to .env.local. Only the public anon key belongs here: every staff action is authorised in Postgres
# (require_staff + MFA checks), never in this web app. Never put the service-role key in a browser build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
