# Ethio Live configuration template. Copy what you need; never commit real values.
# Three places read configuration, and each only gets what it needs:
#   1. Android build  -> android/local.properties (or -P flags / CI env vars). Public identifiers only.
#   2. Admin web app  -> admin/.env.local. Public identifiers only.
#   3. Supabase Edge Functions -> `supabase secrets set --env-file supabase/.env` (server secrets).

# ---------------------------------------------------------------- 1. Android (android/local.properties)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
AGORA_APP_ID=your-agora-app-id
# OAuth 2.0 "Web application" client ID used as the Google Sign-In server client ID (leave empty to hide the button).
GOOGLE_WEB_CLIENT_ID=
# Firebase (push notifications). Leave empty to build without push.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
# google_play for Play Store builds (required by Play policy). google_play,chapa only for builds distributed outside Play.
PAYMENT_PROVIDERS=google_play
# Optional overrides
APPLICATION_ID=et.ethiolive.app
VERSION_CODE=1

# ---------------------------------------------------------------- 2. Admin (admin/.env.local)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------- 3. Edge Function secrets (supabase/.env, never committed)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically on hosted Supabase.
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-primary-certificate
AGORA_TOKEN_TTL_SECONDS=3600
ANDROID_PACKAGE_NAME=et.ethiolive.app
# Service account with "View financial data" + "Manage orders" in Play Console, as one-line JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Random string; put it in the Pub/Sub push endpoint: .../functions/v1/play-notifications?token=<value>
PLAY_RTDN_TOKEN=generate-a-long-random-string
# Chapa (only if offering Chapa outside Play). Use test keys until Chapa approves production.
CHAPA_SECRET_KEY=CHASECK_TEST-...
CHAPA_WEBHOOK_SECRET=the-secret-hash-set-in-the-chapa-dashboard
CHAPA_CALLBACK_URL=https://your-project-ref.supabase.co/functions/v1/chapa-webhook
CHAPA_RETURN_URL=https://your-domain.example/payment-complete
# Firebase service account (Cloud Messaging) as one-line JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=
# Shared secret for the maintenance and send-push schedulers (header x-cron-secret).
CRON_SECRET=generate-a-long-random-string
